# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Première connexion par code (V1 — sans email invite)
# Générer des valeurs aléatoires longues (≥ 32 caractères)
ACTIVATION_CODE_PEPPER=
FIRST_ACCESS_TOKEN_SECRET=

# Cookie signé reset-access (distinct du first-access)
PASSWORD_RESET_TOKEN_SECRET=

# LearnWorlds (école)
# LEARNWORLDS_API_URL = URL API, ex. https://mon-ecole.learnworlds.com/admin/api
LEARNWORLDS_API_URL=
LEARNWORLDS_CLIENT_ID=
LEARNWORLDS_CLIENT_SECRET=
LEARNWORLDS_ACCESS_TOKEN=
# Secret webhook (Settings → Developers → Webhooks)
LEARNWORLDS_WEBHOOK_SECRET=

# Cron Vercel — même valeur dans Project Settings → Environment Variables
# Vercel Cron envoie Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
